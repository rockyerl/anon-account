# -----------------------------------------------------------------------------
# APPLICATION CONFIGURATION
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_NAME="Sundawa Starter"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION (Drizzle ORM with LibSQL/SQLite)
# Local: file:local.db
# Production / Turso: libsql://[db-name]-[org].turso.io?authToken=[token]
# -----------------------------------------------------------------------------
DATABASE_URL=file:local.db

# -----------------------------------------------------------------------------
# AUTHENTICATION & SECURITY
# Generate with: openssl rand -base64 32
# -----------------------------------------------------------------------------
AUTH_SECRET=change-this-to-a-very-secure-random-secret-key-in-production-32chars
